# 복사해서 .env 로 쓰세요 :  cp .env.example .env
# ⚠️ 외부에 공개하기 전에 반드시 키를 바꾸세요 :  python scripts/make_api_key.py admin

# 인증 : '이름:키' 를 쉼표로. demo 키는 그림판에 자동으로 채워지므로 '공개되어도 되는 키'로 둡니다
API_KEYS=admin:dev-admin-key,demo:demo-key
PUBLIC_DEMO_KEY=demo-key
# Streamlit 대시보드가 API 를 부를 때 쓰는 키 (브라우저에는 노출되지 않음)
UI_API_KEY=dev-admin-key

# 모델
MODEL_BACKEND=onnx            # onnx | torchscript | pytorch (뒤의 둘은 torch 가 설치된 환경에서만)
MODEL_VERSION=1.1.0
# 켤 모델 (쉼표 구분). 빼면 그 모델은 로드하지 않습니다 : logreg,mlp,lenet,cnn,lstm,vit
ENABLED_MODELS=logreg,mlp,lenet,cnn,lstm,vit
# 최종 답 투표에 참여할 모델 (나머지는 화면에 '참고'로만). training/ensemble_eval.py 로 고른 조합
ENSEMBLE_MODELS=lenet,cnn,lstm
# '사람 확인 필요' 기준 : 투표 모델의 확률 평균이 0.7 미만이거나, 최종 답에 동의한 비율이 0.66 미만
REVIEW_THRESHOLD=0.7
MIN_AGREEMENT=0.66

# 동시성과 속도 제한
INFER_WORKERS=2
MAX_INFLIGHT=8
QUEUE_TIMEOUT_SEC=2.0
RATE_LIMIT_PER_MIN=120
RATE_LIMIT_BURST=20

# 외부 공개 : 127.0.0.1 = 이 컴퓨터에서만 / 0.0.0.0 = 같은 네트워크·클라우드 VM 에서 접속 허용
BIND_ADDR=127.0.0.1
API_PORT=8000
UI_PORT=8501
CORS_ORIGINS=*
LOG_LEVEL=INFO
